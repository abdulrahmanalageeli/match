# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_SENDER=whatsapp:+your_twilio_sender_number
# Approved template SIDs for Twilio WhatsApp templates (with quick reply buttons)
TWILIO_MATCH_TEMPLATE_SID=HX6d318d6310d7cce0c37b1ef5e0b7a17e
TWILIO_REMINDER_TEMPLATE_SID=your_event_reminder_template_sid
TWILIO_PAYMENT_TEMPLATE_SID=your_payment_reminder_template_sid
TWILIO_GENDER_TEMPLATE_SID=your_gender_preference_template_sid
TWILIO_AGE_FLEX_TEMPLATE_SID=your_age_flexibility_template_sid
TWILIO_DISCOUNT_TEMPLATE_SID=your_discount_offer_template_sid
TWILIO_LATE_CHECK_TEMPLATE_SID=your_participant_late_check_template_sid
TWILIO_FEEDBACK_TEMPLATE_SID=your_feedback_remaining_template_sid
TWILIO_SURVEY_UPDATE_TEMPLATE_SID=HX29303de3e62bac314552ee3056578c4f
# Public webhook used for queued/sent/delivered/read/failed/undelivered callbacks
TWILIO_STATUS_CALLBACK_URL=https://blindmatch.app/api/twilio-status
TWILIO_WEBHOOK_URL=https://blindmatch.app/api/twilio-webhook
# Twilio Verify service for OTP token recovery (WhatsApp channel)
TWILIO_VERIFY_SERVICE_SID=VAyour_verify_service_sid

# Supabase server credentials (never expose the service-role key to Vite/client code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Event 3 admin and limited co-host console
EVENT3_PASSWORD=replace_with_a_strong_admin_password
EVENT3_COHOST_PASSWORD=replace_with_a_different_cohost_password
# Long random secret used to sign eight-hour co-host sessions
EVENT3_COHOST_TOKEN_SECRET=replace_with_at_least_32_random_characters
# Separate long random secret for signed, four-hour administrator sessions
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
# Highest physical table number available at the venue (tables 17+ are lower priority)
EVENT3_MAX_TABLE_NUMBER=24

# The Room is a separate event product with its own login and signed session.
THE_ROOM_ADMIN_KEY=replace_with_a_unique_strong_access_key
THE_ROOM_SESSION_SECRET=replace_with_at_least_32_random_characters

# Public legal identity shown in the privacy notice and terms
VITE_LEGAL_ENTITY_NAME=your_registered_legal_entity_name
VITE_CR_NUMBER=your_commercial_registration_number
VITE_PRIVACY_EMAIL=privacy@your-domain.example
