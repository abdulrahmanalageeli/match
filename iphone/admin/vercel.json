{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": { "api/*.ts": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/maintenance", "schedule": "5 0 * * *" }, { "path": "/api/push", "schedule": "* * * * *" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
    { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
  ]}],
  "rewrites": [{ "source": "/admin/:path*", "destination": "/index.html" }]
}
